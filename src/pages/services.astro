---
import Layout from '../layouts/Layout.astro';

const services = [
  {
    title: "Training",
    description: "Comprehensive emergency preparedness training programs tailored to your organization's needs.",
    items: [
      "Emergency response procedures",
      "Incident command system (ICS) training",
      "Mass sheltering operations",
      "Inclusive planning for vulnerable populations",
      " tabletop exercises",
      "Custom workshops",
    ],
  },
  {
    title: "Consulting",
    description: "Expert guidance to help your organization develop and implement effective emergency plans.",
    items: [
      "Emergency operations plans",
      "Business continuity planning",
      "Shelter management plans",
      "Vulnerable population assessments",
      "Plan reviews and updates",
      "Compliance guidance",
    ],
  },
  {
    title: "Speaking",
    description: "Engaging keynotes and workshops on emergency preparedness topics.",
    items: [
      "Conference keynotes",
      "Workshop facilitation",
      "Panel appearances",
      "Webinar presentations",
      "Media interviews",
      "Custom topic development",
    ],
  },
];
---

<Layout title="Services">
  <section class="bg-gradient-to-r from-primary to-blue-900 text-white py-16">
    <div class="max-w-6xl mx-auto px-4">
      <h1 class="text-4xl md:text-5xl font-bold mb-4">Our Services</h1>
      <p class="text-xl text-gray-200">Emergency planning, training, and consulting for Southern California organizations</p>
    </div>
  </section>

  <section class="py-16">
    <div class="max-w-6xl mx-auto px-4">
      <div class="grid md:grid-cols-3 gap-8">
        {services.map((service) => (
          <div class="bg-white border border-gray-200 rounded-lg p-8 hover:shadow-lg transition">
            <div class="w-12 h-12 bg-accent rounded-lg flex items-center justify-center mb-4">
              {service.title === "Training" && (
                <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
                </svg>
              )}
              {service.title === "Consulting" && (
                <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                </svg>
              )}
              {service.title === "Speaking" && (
                <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 01-3-3V5a3 3 0 116 0v6a3 3 0 01-3 3z" />
                </svg>
              )}
            </div>
            <h3 class="text-xl font-bold mb-3 text-primary">{service.title}</h3>
            <p class="text-gray-600 mb-6">{service.description}</p>
            <ul class="space-y-3">
              {service.items.map((item) => (
                <li class="flex items-center gap-2 text-gray-700">
                  <svg class="w-5 h-5 text-accent flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                  </svg>
                  {item}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-16 bg-gray-50">
    <div class="max-w-6xl mx-auto px-4">
      <h2 class="text-3xl font-bold text-center mb-8 text-primary">Who We Serve</h2>
      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
        <div class="bg-white p-6 rounded-lg text-center">
          <h3 class="font-bold text-lg text-primary mb-2">Businesses</h3>
          <p class="text-gray-600">Corporations and small businesses</p>
        </div>
        <div class="bg-white p-6 rounded-lg text-center">
          <h3 class="font-bold text-lg text-primary mb-2">Schools</h3>
          <p class="text-gray-600">K-12 and higher education</p>
        </div>
        <div class="bg-white p-6 rounded-lg text-center">
          <h3 class="font-bold text-lg text-primary mb-2">Government</h3>
          <p class="text-gray-600">Local and state agencies</p>
        </div>
        <div class="bg-white p-6 rounded-lg text-center">
          <h3 class="font-bold text-lg text-primary mb-2">Nonprofits</h3>
          <p class="text-gray-600">Community organizations</p>
        </div>
      </div>
    </div>
  </section>

  <section class="py-16 bg-primary text-white">
    <div class="max-w-4xl mx-auto px-4 text-center">
      <h2 class="text-3xl font-bold mb-6">Ready to Get Started?</h2>
      <p class="text-xl text-gray-200 mb-8">Contact us today to discuss your emergency planning needs</p>
      <a href="/contact" class="bg-accent hover:bg-orange-600 px-8 py-3 rounded-lg font-semibold text-lg transition inline-block">
        Contact Us
      </a>
    </div>
  </section>
</Layout>